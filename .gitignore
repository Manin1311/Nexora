# Root-level gitignore for Nexora

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated artifacts (AI agent outputs)
artifacts/

# Environment files (never commit secrets)
.env
.env.local
.env.*.local
